<UserControl x:Class="GameWatcher.AuthorStudio.Views.DiscoveryV2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:GameWatcher.AuthorStudio.Converters">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <local:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
        
        <!-- Style for dialogue list items -->
        <Style x:Key="DialogueListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                <StackPanel>
                    <TextBlock Text="Session Status" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Text="{Binding SessionStatus}" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                <StackPanel>
                    <TextBlock Text="Unique Lines Found" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Text="{Binding UniqueLinesFound}" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                <StackPanel>
                    <TextBlock Text="Selected" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Style="{StaticResource MetricValueStyle}">
                        <Run Text="{Binding SelectedDialogue.Timestamp, StringFormat='HH:mm:ss', TargetNullValue='—'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="▶ Start Discovery" Padding="12,6" Margin="0,0,8,0" 
                    Background="LimeGreen" Foreground="White"
                    Command="{Binding StartDiscoveryCommand}"/>
            <Button Content="⏸ Pause" Padding="12,6" Margin="0,0,8,0"
                    Command="{Binding PauseDiscoveryCommand}"/>
            <Button Content="⏹ Stop" Padding="12,6"
                    Command="{Binding StopDiscoveryCommand}"/>
        </StackPanel>

        <!-- Main Content: List + Details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Dialogue List -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0" Background="#2D2D30" Padding="12,8" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                        <TextBlock Text="📝 Discovered Dialogue" FontSize="14" FontWeight="SemiBold"/>
                    </Border>

                    <!-- List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding DiscoveredDialogue}" 
                             SelectedItem="{Binding SelectedDialogue}"
                             ItemContainerStyle="{StaticResource DialogueListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Warning icon if has OCR errors -->
                                    <TextBlock Grid.Column="0" 
                                               Text="⚠" 
                                               FontSize="16" 
                                               Foreground="Orange"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Top"
                                               Visibility="{Binding HasOcrErrors, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="13"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" 
                                                   FontSize="11" 
                                                   Foreground="Gray"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Center"/>

            <!-- Right: Details Pane -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" IsEnabled="{Binding SelectedDialogue, Converter={StaticResource NullToBooleanConverter}}">
                        
                        <!-- No Selection Message -->
                        <TextBlock Text="← Select a dialogue entry to view details" 
                                   FontSize="14" 
                                   Foreground="Gray" 
                                   TextAlignment="Center"
                                   Margin="0,32,0,0"
                                   Visibility="{Binding SelectedDialogue, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Details (when selected) -->
                        <StackPanel Visibility="{Binding SelectedDialogue, Converter={StaticResource NotNullToVisibilityConverter}}">
                            
                            <!-- Timestamp -->
                            <TextBlock Text="⏰ Timestamp" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedDialogue.Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                       FontSize="13" 
                                       Margin="0,0,0,16"/>

                            <!-- Corrected Text -->
                            <TextBlock Text="✏️ Dialogue Text (Editable)" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedDialogue.CorrectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     MinHeight="80" 
                                     MaxHeight="150"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13"
                                     Padding="8"
                                     Margin="0,0,0,16"
                                     Background="#1E1E1E"/>

                            <!-- OCR Debug Image -->
                            <TextBlock Text="🖼️ OCR Debug Image" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4"/>
                            <Border Background="#1E1E1E" 
                                    BorderBrush="#3E3E42" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="8"
                                    Margin="0,0,0,16"
                                    Height="120">
                                <Grid>
                                    <TextBlock Text="OCR debug image will appear here" 
                                               FontSize="11" 
                                               Foreground="Gray"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SelectedDialogue.OcrDebugImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    
                                    <Image Source="{Binding SelectedDialogue.OcrDebugImagePath}" 
                                           Stretch="Uniform"
                                           Visibility="{Binding SelectedDialogue.OcrDebugImagePath, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- OCR Fix Creator (always visible) -->
                            <Border Background="#2D2D30" 
                                    BorderBrush="#3F3F46" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="12"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🔧 OCR Fix Rule" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    
                                    <!-- Multiple fixes indicator -->
                                    <Border Background="#3E3E42" 
                                            Padding="8"
                                            CornerRadius="3"
                                            Margin="0,0,0,8"
                                            Visibility="{Binding MultipleFixesMessage, Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Grid.Column="0" 
                                                    Content="◀"
                                                    Command="{Binding PreviousOcrFixCommand}"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0"
                                                    FontSize="10"
                                                    ToolTip="Previous fix"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding MultipleFixesMessage}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="LightGray"/>
                                            
                                            <Button Grid.Column="2" 
                                                    Content="▶"
                                                    Command="{Binding NextOcrFixCommand}"
                                                    Padding="8,4"
                                                    Margin="8,0,0,0"
                                                    FontSize="10"
                                                    ToolTip="Next fix"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- From Field -->
                                    <TextBlock Text="From (OCR Output):" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OcrFixFrom, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Padding="8"
                                             Margin="0,0,0,8"
                                             ToolTip="The incorrect text that OCR produces"/>

                                    <!-- To Field -->
                                    <TextBlock Text="To (Correct Text):" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OcrFixTo, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Padding="8"
                                             Margin="0,0,0,12"
                                             ToolTip="The correct text it should be"/>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save OCR Fix"
                                        Command="{Binding SaveOcrFixCommand}"
                                        Padding="12,6"
                                        Background="#107C10"
                                        Foreground="White"
                                        Margin="0,0,8,0"
                                        ToolTip="Save this OCR fix rule to the pack"/>
                                
                                <Button Content="Remove"
                                        Command="{Binding RemoveOcrFixCommand}"
                                        Padding="12,6"
                                        Background="#C42B1C"
                                        Foreground="White"
                                        ToolTip="Remove this OCR fix rule from the pack"
                                        IsEnabled="{Binding IsExistingOcrFix}"/>
                            </StackPanel>                                    <!-- Status Message -->
                                    <TextBlock Text="{Binding OcrFixStatusMessage}"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding OcrFixStatusMessage, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Speaker Assignment -->
                            <TextBlock Text="🔊 Speaker" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DataContext.SpeakersViewModel.Speakers, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValue="{Binding SelectedDialogue.SpeakerId, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      Margin="0,0,0,16">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#2D2D30"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Audio Status -->
                            <TextBlock Text="🎵 Audio" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4"/>
                            <Border Background="#1E1E1E" 
                                    BorderBrush="#3E3E42" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="8"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock FontSize="13">
                                        <Run Text="{Binding SelectedDialogue.AudioSourceIcon, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedDialogue.AudioStatusText, Mode=OneWay}"/>
                                    </TextBlock>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="📎 Attach File" Padding="6,4" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="🎤 Generate TTS" Padding="6,4" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Content="✓ Accept" 
                                        Command="{Binding AcceptDialogueCommand}"
                                        Background="#107C10"
                                        Foreground="White"
                                        Padding="12,8"
                                        FontWeight="SemiBold"
                                        Margin="0,0,4,0"/>

                                <Button Grid.Column="1" 
                                        Content="✖ Delete" 
                                        Command="{Binding DeleteDialogueCommand}"
                                        Background="#C42B1C"
                                        Foreground="White"
                                        Padding="12,8"
                                        FontWeight="SemiBold"
                                        Margin="4,0,0,0"/>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
